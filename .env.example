# 本地 Agent 服务使用；不要提交真实密钥
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-flash
BAILIAN_API_KEY=your-bailian-key
BAILIAN_MODEL=qwen-audio-3.1-asr-flash-filetrans
# 可选。不配置时仅依据视频资料和转写推断身份。
# 搜索调用 DeepSeek Search API，与 DEEPSEEK_API_KEY 相同也可以。
DEEPSEEK_SEARCH_API_KEY=

# 可选：本地 Langfuse 项目的 API 密钥，两项都填后启用追踪。
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
