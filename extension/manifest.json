{
  "manifest_version": 3,
  "name": "B站逐字稿",
  "version": "0.4.8",
  "minimum_chrome_version": "116",
  "description": "点击工具栏图标，在浏览器原生侧栏阅读B站逐字稿，点击句子回看。",
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "host_permissions": ["https://www.bilibili.com/*", "https://api.deepseek.com/*", "https://*.aliyuncs.com/*", "https://*.bilivideo.com/*", "https://*.bilivideo.cn/*", "https://*.hdslb.com/*"],
  "action": {
    "default_title": "打开B站逐字稿侧栏",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["subtitles.js"], "matches": ["https://www.bilibili.com/*"] }
  ]
}
