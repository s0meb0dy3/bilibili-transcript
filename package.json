{
  "name": "bilibili-transcript",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify:fixtures": "node scripts/validate-semantic.mjs",
    "segment": "node --env-file=.env scripts/segment.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "package": "npm run check && python3 scripts/package.py"
  }
}
